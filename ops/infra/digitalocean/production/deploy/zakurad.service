[Unit]
Description=Zakura archive node for Ironwood Enhance PIR
After=network-online.target mount-zakura-volume.service
Wants=network-online.target
Requires=mount-zakura-volume.service

[Service]
Type=simple
ExecStart=/usr/local/bin/zakurad --config /etc/zakura/zakura.toml start
Restart=on-failure
RestartSec=10
User=root
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
