[Unit]
Description=Transparent Spend PIR shard worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/enhance-pir-worker --listen 0.0.0.0:8091 --data-dir /srv/transparent-spend-pir/artifacts
Restart=on-failure
RestartSec=3
User=root
LimitNOFILE=1048576
MemoryMax=12G
MemorySwapMax=0
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
