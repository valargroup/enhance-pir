[Unit]
Description=Ironwood memo PIR full-pool coordinator
After=network-online.target zakurad.service
Wants=network-online.target
Requires=zakurad.service

[Service]
Type=simple
ExecStart=/usr/local/bin/memo-pir-server --mode distributed-full --listen 127.0.0.1:8080 --zakura-rpc-url http://127.0.0.1:8232 --zakura-cookie /root/.cache/zakura/.cookie --data-dir /srv/zakura/memo-data --worker-config /etc/memo-pir/workers.json
Restart=on-failure
RestartSec=10
User=root
LimitNOFILE=1048576
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
